	(text "DevKit: ESP32-S3-DevKitC-1 (N16R8 clone), header rows 25.1 mm apart (measured).\nGPIO4 = RELAY_EN (ESPHome restore_mode ALWAYS_OFF), GPIO5 = RELAY_SENSE (LOW = coil on),\nGPIO8 = SDA, GPIO9 = SCL."
		(exclude_from_sim no)
		(at 20.32 228.6 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "bdd6d7c5-88fa-50b0-b4c9-9841269436f9")
	)
	(text "Relay K1: coil 1/16, COM 4/13, NC 6/11, NO 8/9 (Omron datasheet).\nBoth poles in parallel for dry-circuit reliability.\nDe-energised: VE1 -> R10 (fail-safe). Energised: VE1 -> R9 -> AD5272 W-A."
		(exclude_from_sim no)
		(at 152.4 213.36 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "690aed0e-0ba9-5f1b-8e29-6847eec7545f")
	)
	(text "AD5272: ADDR = GND -> I2C 0x2F. RESET tied to VDD.\nFirmware: write control reg C1=1 at boot, never set C0 (50-TP)."
		(exclude_from_sim no)
		(at 223.52 147.32 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "ba763c5d-38ac-5c85-a5cd-e5eb771ec066")
	)
	(text "R8 is DNP: fit only if TEM no-load output > 5.4 V."
		(exclude_from_sim no)
		(at 208.28 55.88 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "0b55a724-445f-5cb7-b394-0a06e6a475dd")
	)
